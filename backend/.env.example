# Copie para .env e ajuste conforme o ambiente.
# Todas as variáveis usam o prefixo LABTRACK_.

LABTRACK_ENVIRONMENT=development        # development | test | production
LABTRACK_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LABTRACK_LOG_FORMAT=text                # text | json
LABTRACK_CORS_ORIGINS=["http://localhost:5173"]

LABTRACK_DATABASE_URL=postgresql+psycopg://labtrack:labtrack@localhost:5432/labtrack
LABTRACK_DATABASE_ECHO=false            # true = loga o SQL gerado
