# Variáveis do docker compose (copie para .env). Todas têm padrão para a demonstração.

# Porta da interface no host (http://localhost:8080) e do PostgreSQL.
LABTRACK_HTTP_PORT=8080
LABTRACK_DB_PORT=5432

# Banco
POSTGRES_USER=labtrack
POSTGRES_PASSWORD=labtrack
POSTGRES_DB=labtrack

# Demonstração: dados de exemplo na primeira subida, usuários listados no login.
LABTRACK_SEED_DEMO=true
LABTRACK_DEMO_MODE=true
LABTRACK_DEMO_PASSWORD=Demo@2026
LABTRACK_SIMULATOR_INTERVAL=30

# Produção: LABTRACK_ENVIRONMENT=production exige uma chave própria, desliga a
# demonstração (LABTRACK_SEED_DEMO=false, LABTRACK_DEMO_MODE=false) e o primeiro
# administrador é criado com:
#   docker compose run --rm -e LABTRACK_ADMIN_PASSWORD=... api python -m app.cli create-admin
# Gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
LABTRACK_ENVIRONMENT=development
# LABTRACK_JWT_SECRET_KEY=

# Laboratório
LABTRACK_LAB_TIMEZONE=America/Sao_Paulo
LABTRACK_LAB_NAME="Laboratório de Controle de Qualidade"
